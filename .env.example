# Copy to .env and fill in real values. .env is gitignored — never commit it.

# SQLite by default (Coolify-mounted volume in production). Swap to a
# postgresql:// URL when the project upgrades off SQLite — no code change
# needed (STORE-01).
DATABASE_URL=sqlite:////data/app.db

# MUST be a descriptive app name plus a real contact email, e.g.
# "DataCenterStocks you@example.com". SEC EDGAR returns 403 and can
# IP-block for ~10 minutes on requests carrying a generic/missing
# User-Agent — that failure mode takes down every remaining ticker in a
# refresh run, not just one (RESEARCH.md Pitfall 3).
EDGAR_USER_AGENT=DataCenterStocks you@example.com
